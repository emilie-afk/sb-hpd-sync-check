# Placeholders only. Set real values in Netlify → Site configuration →
# Environment variables, scope "Functions", marked as secret. Never commit them.

# Authentication (required — without them every request is denied)
SITE_PASSWORD=<shared team password>
SESSION_SECRET=<random string, at least 32 characters, different from SITE_PASSWORD>

# Data sources (required — without them the check returns a configuration error)
GOOGLE_SHEETS_API_KEY=<Google Sheets API key>
HPD_INVENTORY_SHEET_ID=<inventory spreadsheet ID>
PRODUCTS_MASTER_SHEET_ID=<Products Master spreadsheet ID>
PRODUCTS_MASTER_TAB_GID=<numeric gid of the Products Master tab>

# Optional
# SESSION_EPOCH=1                 # change to sign everyone out
# SESSION_TTL_HOURS=12
# LOGIN_MAX_FAILURES_PER_IP=10
# LOGIN_MAX_FAILURES_GLOBAL=100
# LOGIN_WINDOW_MINUTES=15
# CHECK_BUDGET_MS=9000            # keep below the Netlify function timeout
# CHECK_CACHE_SECONDS=30
# CHECK_MAX_PER_SESSION=10
# CHECK_MAX_GLOBAL=40
# CHECK_WINDOW_MINUTES=10
